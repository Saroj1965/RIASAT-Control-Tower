# =====================================================================
# RIASAT EXECUTIVE CONTROL TOWER: SUPABASE ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Supabase Project REST URL (Found in: Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# 2. Supabase Anonymous Public Key (Found in: Project Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"

# 3. Supabase Service Role Secret Key (Found in: Project Settings -> API -> Project API keys -> service_role secret)
# Required for server-side administrative access and bypassing RLS
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"

# 4. Supabase Direct / Transaction Pooler Database Connection String
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres"

# Optional Supabase Database direct connection alias
SUPABASE_DB_URL=""

# =====================================================================
# SECURITY & RUNTIME
# =====================================================================
# JWT Authentication Secret Key for signed session cookies
JWT_SECRET="riasat-executive-tower-secure-key-2026-production"

# Application Port (Default: 3000)
PORT=3000
