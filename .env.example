# =====================================================================
# RIASAT EXECUTIVE DASHBOARD: SUPABASE & AUTH ENVIRONMENT CONFIGURATION
# =====================================================================

# 1. Supabase Project URL (Found in: Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://qbotswjhmmquvmhwrawq.supabase.co"

# 2. Supabase Anonymous Public Key (Found in: Project Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 3. Supabase Service Role Secret Key (Server-side only — NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 4. Shared Login Email Restriction (Server-side only — optional)
#    When set, only this single email address is permitted to sign in via Supabase Auth.
SHARED_LOGIN_EMAIL="your-shared-login-email@riasat.ac.in"

# 5. Public Application URL (Used for Supabase Auth password reset redirect links)
NEXT_PUBLIC_APP_URL="https://riasat-executive-dashboard.vercel.app"

# 6. JWT Session Signing Secret (Server-side only)
JWT_SECRET="replace-with-strong-random-secret"

# Application Port (Default: 3000)
PORT=3000
